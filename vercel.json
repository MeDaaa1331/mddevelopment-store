{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|svg|webp|ico|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/wheel/:action*",
      "destination": "/api/wheel?action=:action*"
    },
    {
      "source": "/api/points/:action*",
      "destination": "/api/points?action=:action*"
    },
    {
      "source": "/api/giftcard",
      "destination": "/api/coupons?action=giftcard"
    },
    {
      "source": "/(store|scripts)/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([dD]iscord|[tT]witter|[fF]acebook|[fF]acebot|[tT]elegram|[wW]hats[aA]pp|[sS]lack|[bB]ot|[cC]rawl|[sS]pider|[pP]review|[lL]inked[iI]n|[eE]mbed|[pP]interest|[sS]kype|[aA]pplebot|[gG]oogle|[yY]ahoo|[bB]ing|[dD]uck[dD]uck|[bB]aidu|[yY]andex|[vV]k[sS]hare|[wW]get|[cC]url).*"
        }
      ],
      "destination": "/api/embed?slug=:slug*"
    },
    {
      "source": "/(store|scripts)/:slug*",
      "has": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "destination": "/api/embed?slug=:slug*"
    },
    {
      "source": "/api/embed/:slug*",
      "destination": "/api/embed?slug=:slug*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
